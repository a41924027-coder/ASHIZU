PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/ashizu
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_API_KEY=replace_with_a_random_secret_at_least_32_characters
DB_POOL_MAX=10
PGSSL=false
# Razorpay TEST keys first; switch to LIVE only after successful end-to-end tests.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

CUSTOMER_TOKEN_SECRET=replace_with_a_separate_random_secret
OTP_PEPPER=replace_with_a_random_secret
# Production OTP email delivery (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
MAIL_FROM=ASHIZU <no-reply@example.com>
